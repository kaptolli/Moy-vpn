<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WarpX"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="4 режима в одном VPN"
            android:textSize="14sp"
            android:alpha="0.7" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <RadioButton
                android:id="@+id/rbWarp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1 · Warp (WireGuard)" />

            <RadioButton
                android:id="@+id/rbDpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 · DPI-обход (byebyedpi)" />

            <RadioButton
                android:id="@+id/rbWhitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 · Обход белого списка" />

            <RadioButton
                android:id="@+id/rbBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4 · Блокировка (flowseal)" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Подключить" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Отключить" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Профиль Warp:"
            android:textSize="13sp"
            android:alpha="0.8" />

        <Spinner
            android:id="@+id/spProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnRotate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Авто-перебор профилей" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Импорт профилей (.conf, можно много)" />

        <Button
            android:id="@+id/btnAutotest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Автотест стратегий" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:text="Статус: отключено" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
